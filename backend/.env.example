PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# Live generative AI (configure this only in backend/.env)
GEMINI_API_KEY=
# Optional; defaults to gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional real YouTube video references (enable YouTube Data API v3 in Google Cloud)
YOUTUBE_API_KEY=
